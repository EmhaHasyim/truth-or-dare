{
  "name": "truth-or-dare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run db:migrate && bun run db:seed && vite dev",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite build && wrangler dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run test",
    "sync:secrets": "bun scripts/sync-secrets.ts",
    "deploy": "bun run build && wrangler deploy && bun run sync:secrets",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply truth-or-dare-db --local",
    "db:seed": "wrangler d1 execute truth-or-dare-db --local --file=migrations/seed.sql",
    "db:studio": "drizzle-kit studio",
    "db:reset": "wrangler d1 execute truth-or-dare-db --local --command=\"DROP TABLE IF EXISTS d1_migrations; DROP TABLE IF EXISTS turns; DROP TABLE IF EXISTS games; DROP TABLE IF EXISTS questions; DROP TABLE IF EXISTS players; DROP TABLE IF EXISTS rooms;\" && bun run db:migrate && bun run db:seed"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@hono/zod-validator": "^0.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/solid-query": "^5.101.4",
    "@tanstack/solid-router": "^1.170.19",
    "canvas-confetti": "^1.9.4",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.0",
    "lucide-solid": "^1.28.0",
    "solid-js": "^1.9.14",
    "solid-transition-group": "^0.3.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@solidjs/testing-library": "^0.8.10",
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/router-cli": "^1.167.22",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "daisyui": "^5.7.16",
    "drizzle-kit": "1.0.0-rc.4",
    "happy-dom": "^20.11.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "undici": "^8.10.0",
    "vite": "^8.2.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
